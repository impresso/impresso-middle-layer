  "scripts": {
    "watch": "tsc -p ./tsconfig.json -w",
    "typecheck": "tsc -p ./tsconfig.json",
    "test": "mocha",
    "test-watch": "mocha --watch 'test/**/*.test.{js,ts}'",
    "integration-test": "mocha --inspect --config ./.mocharc-integration.json",
    "lintfix": "eslint src/. --config .eslintrc.mjs --fix",
    "lint": "eslint src/. --config .eslintrc.mjs",
    "lint-api-spec": "spectral lint http://localhost:3030/swagger.json ",
    "start": "tsx --env-file=./.env src/index.ts",
    "dev": "tsx --env-file=./.env --watch src/index.ts",
    "bun-run": "bun run --watch src/index.ts",
    "bun-test": "bun test",
    "cli": "node src/admin/cli.js",
    "generate-internal-types": "node src/scripts/generate-types.js",
    "generate-types-from-schemas-repo": "node src/scripts/generate-types-from-schemas-repo.js",
    "generate-types": "npm run generate-internal-types && npm run generate-types-from-schemas-repo"
  },
