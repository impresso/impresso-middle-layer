{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run dev server ⚙️",
      "type": "npm",
      "script": "dev",
      "group": {
        "isDefault": true
      }
    },
    {
      "label": "Watch build 👀",
      "type": "npm",
      "script": "watch",
      "problemMatcher": ["$tsc-watch"],
      "group": {
        "isDefault": false
      }
    },
    {
      "label": "Generated types",
      "type": "npm",
      "script": "generate-types",
      "group": {
        "isDefault": false
      }
    },
    {
      "label": "Typecheck 🔍",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "group": {
        "isDefault": false
      }
    },
    {
      "label": "Create exports folder 📁",
      "type": "shell",
      "command": "mkdir",
      "args": ["-p", "/tmp/impresso-exports"],
      "group": {
        "isDefault": false
      }
    }
  ]
}