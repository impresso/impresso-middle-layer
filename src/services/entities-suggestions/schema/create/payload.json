{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Payload for POST /entities-suggestions",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "offset": {
      "type": "number",
      "minimum": 0
    },
    "limit": {
      "type": "number",
      "minimum": 1
    }
  },
  "required": ["names"]
}
