{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Query params validation for /entities find",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "filters": {
      "type": "array",
      "items": {
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "type", "id"]
          },
          "q": {
            "type": ["string", "array"]
          },
          "op": {
            "type": "string",
            "enum": ["AND", "OR"]
          }
        }
      }
    },
    "resolve": {
      "type": "boolean"
    },
    "q": {
      "type": "string",
      "maxLength": 100
    },
    "order_by": {
      "type": "string",
      "description": "Order intersection items by this value",
      "enum": ["relevance", "-relevance", "name", "-name", "count", "-count", "count-mentions", "-count-mentions"]
    },
    "limit": {
      "type": "integer",
      "description": "Limit to this many items",
      "default": 10,
      "minimum": 0,
      "maximum": 10000
    },
    "offset": {
      "type": "integer",
      "description": "Skip this many items",
      "minimum": 0
    },
    "page": {
      "type": "integer",
      "description": "DEPRECATED. Display N-th page (using 'limit' as the number of items in the page). Only used in the web app.",
      "minimum": 1
    }
  }
}
