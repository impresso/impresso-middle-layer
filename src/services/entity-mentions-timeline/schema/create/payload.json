{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Payload validation for POST /entity-mentions-timeline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "filters": {
      "type": "array",
      "items": {
        "$ref": "../../../../schema/canonical/Filter.json"
      }
    },
    "entityId": {
      "type": "string",
      "description": "Entity to get timeline for"
    },
    "mentionLabel": {
      "type": "string",
      "description": "Label of mention to get timeline for"
    },
    "mentionType": {
      "type": "string",
      "description": "Type of mention",
      "enum": ["person", "location", "organisation", "newsagency"]
    },
    "timeResolution": {
      "type": "string",
      "enum": ["year", "month"],
      "description": "Time resolution for the timeline. Default is year"
    },
    "limit": {
      "type": "integer",
      "description": "Limit to this many items",
      "default": 10,
      "minimum": 0,
      "maximum": 10000
    },
    "offset": {
      "type": "integer",
      "description": "Skip this many items",
      "minimum": 0
    }
  },
  "oneOf": [{ "required": ["entityId"] }, { "required": ["mentionLabel"] }]
}
