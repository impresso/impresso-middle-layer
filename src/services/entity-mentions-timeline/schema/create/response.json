{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Response validation for POST /entity-mentions-timeline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "item": {
      "$ref": "#/definitions/entityOrMention"
    },
    "subitems": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entityOrMention"
      }
    },
    "totalSubitems": {
      "type": "integer",
      "description": "Total number of subitems available"
    }
  },
  "definitions": {
    "entityOrMention": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["entity", "mention"]
        },
        "id": {
          "type": "string",
          "description": "Entity Id"
        },
        "label": {
          "type": "string",
          "description": "Entity label"
        },
        "entityType": {
          "type": "string",
          "description": "Entity type"
        },
        "wikidataId": {
          "type": "string"
        },
        "thumbnailUrl": {
          "type": "string"
        },
        "mentionFrequencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "val": {
                "anyOf": [{ "type": "string" }, { "type": "integer" }]
              },
              "count": {
                "type": "integer"
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "required": ["label", "type"]
    }
  }
}
