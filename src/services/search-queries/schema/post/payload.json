{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Request payload for POST /search-queries",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1000
    },
    "data": {
      "type": "string",
      "minLength": 2,
      "title": "Buffered JSON object containing an array of filters",
      "examples": ["KgZhYmMxMjM="]
    },
    "countItems": {
      "type": ["integer", "string"],
      "title": "Number of results when the search was saved",
      "default": 0,
      "examples": [3245]
    }
  },
  "required": ["name", "description", "data", "countItems"]
}
