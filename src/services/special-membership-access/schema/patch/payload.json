{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "SpecialMembershipAccessPatchPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modality": {
          "type": "string",
          "enum": ["notify_reviewer", "cc_reviewer"]
        },
        "expireDate": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        }
      }
    }
  }
}
