{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Description of the search query object (SearchQuery class)",
  "type": "object",
  "additionalProperties": false,
  "required": ["uid", "name", "description", "data", "creationDate", "lastModifiedDate", "countItems", "creator"],
  "properties": {
    "uid": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1000
    },
    "data": {
      "type": "string",
      "minLength": 2,
      "title": "Buffered JSON object containing an array of filters",
      "examples": ["KgZhYmMxMjM="]
    },
    "creationDate": {
      "type": "string"
    },
    "lastModifiedDate": {
      "type": "string"
    },
    "countItems": {
      "type": ["integer", "string"],
      "title": "Number of results when the search was saved",
      "default": 0,
      "examples": [3245]
    },
    "creator": {
      "$ref": "./base-user.model.json"
    }
  }
}
