{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdminPatchRequest",
  "description": "Admin maintenance action request.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": ["clear-db-cache", "clear-solr-cache", "clear-wikidata-cache", "rebuild-well-known-cache"]
    }
  },
  "required": ["action"]
}
